<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>ARMITANO — El Intermediario</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap');

:root{
  --negro:#070a08;
  --dorado:#c9a961;
  --dorado-brillante:#e8d39a;
  --rojo:#7a1f2b;
  --hueso:#e8e2d4;
  --hueso-muted:#8a8478;
  --linea:#2a2a22;
}
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  margin:0; background:var(--negro); color:var(--hueso);
  font-family:'EB Garamond', Georgia, serif; overflow-x:hidden;
  background-image:
    radial-gradient(ellipse at 50% 0%, rgba(201,169,97,0.05), transparent 55%),
    radial-gradient(ellipse at 50% 100%, rgba(122,31,43,0.04), transparent 60%);
}
.serif{font-family:'Cormorant Garamond', Georgia, serif;}

.panel{
  min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center;
  text-align:center; padding:14vh 8vw; position:relative;
}
.panel.compacto{min-height:auto; padding:12vh 8vw;}

.reveal{opacity:0; transform:translateY(26px); transition:opacity 1.1s ease, transform 1.1s ease;}
.visible .reveal{opacity:1; transform:translateY(0);}
.visible .r1{transition-delay:.05s;}
.visible .r2{transition-delay:.55s;}
.visible .r3{transition-delay:1.05s;}
.visible .r4{transition-delay:1.55s;}

.divisor{width:1px; height:60px; background:linear-gradient(var(--dorado), transparent); margin:36px auto; opacity:.5;}
.divisor-h{width:70px; height:1px; background:var(--dorado); margin:22px auto; opacity:.55;}

.sello-grande{width:84px; height:84px; border-radius:50%; background:var(--rojo); border:1.5px solid var(--dorado); display:flex; align-items:center; justify-content:center; margin:0 auto;}
.sello-grande span{font-family:'Cormorant Garamond', serif; font-weight:600; font-size:36px; color:var(--dorado-brillante);}

h1.titulo-intro{font-size:15px; letter-spacing:8px; color:var(--hueso-muted); text-transform:uppercase; margin:34px 0 0; font-weight:400; font-family:'EB Garamond', serif;}

.frase-fina{font-family:'Cormorant Garamond', serif; font-style:italic; font-size:24px; line-height:1.6; color:var(--hueso); max-width:520px; margin:6px auto;}

h2.titulo-grande{
  font-family:'Cormorant Garamond', serif; font-weight:500; font-size:clamp(38px,7vw,64px);
  letter-spacing:6px; color:var(--dorado); text-transform:uppercase; margin:0;
}

.numeral{font-family:'Cormorant Garamond', serif; font-size:20px; color:var(--rojo); letter-spacing:4px; margin-bottom:6px;}
.titulo-puerta{font-family:'Cormorant Garamond', serif; font-size:clamp(30px,5vw,46px); color:var(--dorado); letter-spacing:4px; text-transform:uppercase; margin:0 0 6px;}
.subtitulo-puerta{font-family:'Cormorant Garamond', serif; font-style:italic; font-size:19px; color:var(--hueso-muted); margin-bottom:26px;}
.texto-puerta{max-width:540px; font-size:17px; line-height:1.85; color:var(--hueso); margin:0 auto;}

.pregunta{font-family:'Cormorant Garamond', serif; font-size:clamp(24px,4.2vw,32px); color:var(--hueso); max-width:480px; line-height:1.5;}

.respuesta-linea{font-family:'Cormorant Garamond', serif; font-style:italic; font-size:21px; color:var(--hueso-muted); margin:4px 0;}
.respuesta-final{font-family:'Cormorant Garamond', serif; font-size:clamp(24px,4vw,32px); color:var(--dorado-brillante); max-width:560px; line-height:1.5; margin-top:22px;}

.mesa-svg{width:min(300px,70vw); height:auto; margin:0 auto 28px;}
.manifiesto{font-size:13px; letter-spacing:4px; color:var(--dorado); text-transform:uppercase; margin:26px 0 22px;}
.narrativa{max-width:560px; font-size:17px; line-height:1.9; color:var(--hueso);}
.narrativa p{margin:0 0 14px;}

.titulo-seccion{font-family:'Cormorant Garamond', serif; font-size:clamp(28px,5vw,40px); color:var(--dorado); letter-spacing:5px; text-transform:uppercase; margin:0 0 10px;}
.sub-seccion{color:var(--hueso-muted); font-size:15px; max-width:440px; line-height:1.6; margin-bottom:34px;}

form.huella-form{width:100%; max-width:420px; text-align:left;}
form.huella-form label{display:block; font-size:12px; letter-spacing:1px; text-transform:uppercase; color:var(--hueso-muted); margin-bottom:5px;}
form.huella-form input, form.huella-form textarea{
  width:100%; background:rgba(255,255,255,0.03); border:1px solid var(--linea); color:var(--hueso);
  padding:11px 12px; border-radius:2px; font-family:'EB Garamond', serif; font-size:16px; margin-bottom:16px;
}
form.huella-form textarea{min-height:70px; resize:vertical;}
.btn-dorado{
  width:100%; background:transparent; border:1px solid var(--dorado); color:var(--dorado-brillante);
  padding:13px; font-family:'EB Garamond', serif; font-size:15px; letter-spacing:2px; text-transform:uppercase;
  cursor:pointer; transition:all .3s ease;
}
.btn-dorado:hover{background:var(--dorado); color:var(--negro);}
.gracias-huella{color:var(--ok,#7a9a7a); font-size:15px; margin-top:6px;}

.paredon{width:100%; max-width:700px; display:flex; flex-direction:column; gap:1px; background:var(--linea);}
.placa{background:var(--negro); padding:20px 22px; text-align:left;}
.placa .momento{font-size:11px; letter-spacing:2px; color:var(--rojo); text-transform:uppercase; margin-bottom:6px;}
.placa .nombre-lugar{font-family:'Cormorant Garamond', serif; color:var(--dorado-brillante); font-size:19px; margin-bottom:2px;}
.placa .fecha{color:var(--hueso-muted); font-size:12px; margin-bottom:10px;}
.placa .frase{font-family:'Cormorant Garamond', serif; font-style:italic; color:var(--hueso); font-size:16px; line-height:1.5;}
.paredon-vacio{color:var(--hueso-muted); font-style:italic; font-size:15px;}

.scroll-cue{position:absolute; bottom:6vh; left:50%; transform:translateX(-50%); opacity:.6; animation:rebote 2.4s ease-in-out infinite;}
@keyframes rebote{0%,100%{transform:translate(-50%,0);}50%{transform:translate(-50%,10px);}}

.pie{padding:60px 8vw 50px; text-align:center;}
.pie .sello-chica{width:40px; height:40px; border-radius:50%; background:var(--rojo); border:1px solid var(--dorado); display:flex; align-items:center; justify-content:center; margin:0 auto 14px;}
.pie .sello-chica span{font-family:'Cormorant Garamond', serif; font-weight:600; font-size:17px; color:var(--dorado-brillante);}
.pie .lema{font-size:11px; letter-spacing:3px; color:var(--hueso-muted); text-transform:uppercase;}

.toast{
  position:fixed; bottom:20px; left:50%; transform:translateX(-50%);
  background:#141410; border:1px solid var(--dorado); color:var(--hueso);
  padding:10px 20px; font-size:14px; z-index:200; opacity:0; transition:opacity .3s ease; pointer-events:none;
}
.toast.mostrar{opacity:1;}

@media(max-width:640px){
  .panel{padding:10vh 7vw;}
  .texto-puerta, .narrativa, .sub-seccion{font-size:16px;}
}
</style>
</head>
<body>

<!-- 1. BIENVENIDA -->
<section class="panel reveal-root">
  <div class="reveal r1"><div class="sello-grande"><span>A</span></div></div>
  <div class="reveal r2"><h1 class="titulo-intro">Bienvenido a la mesa</h1></div>
  <div class="scroll-cue reveal r4">
    <svg width="20" height="26" viewBox="0 0 20 26" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M2 8 L10 16 L18 8" stroke="#c9a961" stroke-width="1.4"/>
      <path d="M2 18 L10 26 L18 18" stroke="#c9a961" stroke-width="1.4" opacity=".5"/>
    </svg>
  </div>
</section>

<!-- 2. PRÓLOGO / EL INTERMEDIARIO -->
<section class="panel reveal-root">
  <div class="reveal r1"><p class="frase-fina">Hay encuentros que merecen<br>una buena conversación.</p></div>
  <div class="reveal r2"><p class="frase-fina">Y conversaciones que merecen<br>algo más.</p></div>
  <div class="divisor reveal r3"></div>
  <div class="reveal r3"><h2 class="titulo-grande">El Intermediario</h2></div>
</section>

<!-- 3. PUERTA I — CALIDAD -->
<section class="panel reveal-root">
  <div class="reveal r1">
    <div class="numeral">I</div>
    <h3 class="titulo-puerta">Calidad</h3>
    <p class="subtitulo-puerta">Una forma de hacer.</p>
  </div>
  <div class="reveal r2">
    <p class="texto-puerta">Buscar la excelencia no es una pose. Es cuidar el detalle que nadie va a notar, elegir el camino largo cuando el corto alcanzaría, y hacer las cosas bien incluso — sobre todo — cuando nadie está mirando.</p>
  </div>
</section>

<!-- 4. PUERTA II — PRUDENCIA -->
<section class="panel reveal-root">
  <div class="reveal r1">
    <div class="numeral">II</div>
    <h3 class="titulo-puerta">Prudencia</h3>
    <p class="subtitulo-puerta">Una forma de representar.</p>
  </div>
  <div class="reveal r2">
    <p class="texto-puerta">Hay una responsabilidad silenciosa en todo lo que uno hace: la palabra que da, el nombre que lleva, aquello que decide representar. La prudencia no es cautela — es coherencia entre quién sos y lo que ofrecés.</p>
  </div>
</section>

<!-- 5. PUERTA III — VÍNCULO -->
<section class="panel reveal-root">
  <div class="reveal r1">
    <div class="numeral">III</div>
    <h3 class="titulo-puerta">Vínculo</h3>
    <p class="subtitulo-puerta">Una forma de construir.</p>
  </div>
  <div class="reveal r2">
    <p class="frase-fina" style="font-size:26px; margin-bottom:22px;">Las cosas más grandes<br>no se consiguen solos.</p>
  </div>
  <div class="reveal r3">
    <p class="texto-puerta">Las personas, las conversaciones y las relaciones son las que permiten construir algo realmente importante. Nada memorable se hizo en soledad.</p>
  </div>
</section>

<!-- 6. LA PREGUNTA -->
<section class="panel reveal-root" style="min-height:80vh;">
  <div class="reveal r1"><p class="pregunta">¿Quién es el Intermediario?</p></div>
</section>

<!-- 7. LA RESPUESTA -->
<section class="panel reveal-root">
  <div class="reveal r1"><p class="respuesta-linea">A veces es una botella.</p></div>
  <div class="reveal r2"><p class="respuesta-linea">A veces es una conversación.</p></div>
  <div class="reveal r3"><p class="respuesta-linea">A veces es una persona.</p></div>
  <div class="reveal r4"><p class="respuesta-final">El Intermediario es aquello que logra que dos cosas se encuentren.</p></div>
</section>

<!-- 8. LA MESA -->
<section class="panel reveal-root">
  <div class="reveal r1">
    <svg class="mesa-svg" viewBox="0 0 300 300" xmlns="http://www.w3.org/2000/svg">
      <circle cx="150" cy="150" r="95" fill="none" stroke="#c9a961" stroke-width="1" opacity=".55"/>
      <circle cx="150" cy="150" r="6" fill="none" stroke="#c9a961" stroke-width="1" opacity=".7"/>
      <line x1="150" y1="128" x2="150" y2="95" stroke="#c9a961" stroke-width="1" opacity=".5"/>
      <g stroke="#c9a961" stroke-width="1" fill="none" opacity=".8">
        <path d="M150 60 C142 60 137 66 137 74 C137 84 150 92 150 92 C150 92 163 84 163 74 C163 66 158 60 150 60 Z"/>
        <line x1="150" y1="92" x2="150" y2="106"/>
        <line x1="141" y1="106" x2="159" y2="106"/>
      </g>
      <g stroke="#c9a961" stroke-width="1" fill="none" opacity=".8" transform="rotate(115 150 150)">
        <path d="M150 60 C142 60 137 66 137 74 C137 84 150 92 150 92 C150 92 163 84 163 74 C163 66 158 60 150 60 Z"/>
        <line x1="150" y1="92" x2="150" y2="106"/>
        <line x1="141" y1="106" x2="159" y2="106"/>
      </g>
      <g stroke="#c9a961" stroke-width="1" fill="none" opacity=".8" transform="rotate(235 150 150)">
        <path d="M150 60 C142 60 137 66 137 74 C137 84 150 92 150 92 C150 92 163 84 163 74 C163 66 158 60 150 60 Z"/>
        <line x1="150" y1="92" x2="150" y2="106"/>
        <line x1="141" y1="106" x2="159" y2="106"/>
      </g>
      <g opacity=".45">
        <circle cx="150" cy="66" r="2" fill="#c9a961"/>
        <circle cx="150" cy="234" r="2" fill="#c9a961"/>
        <circle cx="66" cy="150" r="2" fill="#c9a961"/>
        <circle cx="234" cy="150" r="2" fill="#c9a961"/>
        <circle cx="93" cy="93" r="2" fill="#c9a961"/>
        <circle cx="207" cy="207" r="2" fill="#c9a961"/>
        <circle cx="93" cy="207" r="2" fill="#c9a961"/>
        <circle cx="207" cy="93" r="2" fill="#c9a961"/>
      </g>
    </svg>
  </div>
  <div class="reveal r2"><p class="manifiesto">La bebida predilecta de las damas y los caballeros</p></div>
  <div class="reveal r3 narrativa">
    <p>No es, necesariamente, una historia real. Es el imaginario de ARMITANO.</p>
    <p>Una mesa reúne personas que probablemente nunca se habrían encontrado de otro modo.</p>
    <p>Una conversación abre una puerta. Una copa acompaña el momento. Y algo comienza.</p>
  </div>
</section>

<!-- 9. DEJÁ TU HUELLA -->
<section class="panel reveal-root">
  <div class="reveal r1">
    <h2 class="titulo-seccion">Dejá tu huella</h2>
    <p class="sub-seccion">¿Con quién compartiste esta botella? Quedará registrado en El Paredón, junto a los demás momentos ARMITANO.</p>
  </div>
  <div class="reveal r2" style="width:100%; display:flex; justify-content:center;" id="contenedor-form-huella">
    <form class="huella-form" id="form-huella" onsubmit="return false;">
      <label>Nombre o apodo</label>
      <input type="text" id="h-nombre" placeholder="¿Quién brindó?">
      <label>Lugar</label>
      <input type="text" id="h-lugar" placeholder="¿Dónde fue?">
      <label>La ocasión / una frase</label>
      <textarea id="h-frase" placeholder="Por los proyectos que todavía no existen…"></textarea>
      <button class="btn-dorado" onclick="enviarHuella()">Dejar mi huella</button>
    </form>
  </div>
</section>

<!-- 10. EL PAREDÓN -->
<section class="panel compacto reveal-root">
  <div class="reveal r1">
    <h2 class="titulo-seccion">El Paredón</h2>
    <p class="sub-seccion">Momentos que otros dejaron al pasar por acá.</p>
  </div>
  <div class="reveal r2" id="paredon-contenido" style="width:100%; display:flex; justify-content:center;">
    <p class="paredon-vacio">Cargando…</p>
  </div>
</section>

<div class="pie">
  <div class="sello-chica"><span>A</span></div>
  <div class="lema">Calidad · Prudencia · Vínculo</div>
</div>

<div class="toast" id="toast"></div>

<script>
// ==== CONFIGURACIÓN ====
// Pegá acá la URL de tu Apps Script (la que termina en /exec) antes de publicar esta página.
const SCRIPT_URL_FIJA = '';
const SCRIPT_URL = SCRIPT_URL_FIJA || localStorage.getItem('armitano_script_url') || '';

function apiCall(action, payload) {
  payload = payload || {};
  return new Promise((resolve) => {
    if (!SCRIPT_URL) { resolve({ error: 'no_url' }); return; }
    const cb = 'cb_' + Date.now() + '_' + Math.floor(Math.random() * 100000);
    let resuelto = false;
    window[cb] = (data) => { if (!resuelto) { resuelto = true; delete window[cb]; resolve(data); } };
    const url = SCRIPT_URL + '?action=' + encodeURIComponent(action) +
      '&data=' + encodeURIComponent(JSON.stringify(payload)) + '&callback=' + cb;
    const s = document.createElement('script');
    s.src = url;
    s.onerror = () => { if (!resuelto) { resuelto = true; resolve({ error: 'network' }); delete window[cb]; } };
    document.head.appendChild(s);
    setTimeout(() => { if (!resuelto) { resuelto = true; resolve({ error: 'timeout' }); delete window[cb]; } }, 20000);
  });
}

function escapeHtml(str) {
  return String(str == null ? '' : str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function mostrarToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('mostrar');
  setTimeout(() => t.classList.remove('mostrar'), 3200);
}

/* ---------------- animaciones al hacer scroll ---------------- */
const observador = new IntersectionObserver((entradas) => {
  entradas.forEach(e => {
    if (e.isIntersecting) e.target.classList.add('visible');
  });
}, { threshold: 0.22 });
document.querySelectorAll('.reveal-root').forEach(el => observador.observe(el));

/* ---------------- dejá tu huella ---------------- */
function enviarHuella() {
  const nombre = document.getElementById('h-nombre').value.trim();
  const lugar = document.getElementById('h-lugar').value.trim();
  const frase = document.getElementById('h-frase').value.trim();
  if (!nombre) { mostrarToast('Contanos quién brindó, al menos.'); return; }
  const data = {
    NombreApodo: nombre,
    Fecha: new Date().toISOString().slice(0, 10),
    Lugar: lugar,
    Frase: frase
  };
  apiCall('saveHuella', data).then(res => {
    if (res && res.error) { mostrarToast('No se pudo guardar. Probá de nuevo.'); return; }
    document.getElementById('contenedor-form-huella').innerHTML =
      '<p class="gracias-huella">Momento Nº ' + escapeHtml(res.Momento) + ' registrado. Gracias por dejar tu huella.</p>';
    cargarParedon();
  });
}

/* ---------------- el paredón ---------------- */
function cargarParedon() {
  const cont = document.getElementById('paredon-contenido');
  apiCall('getHuellas').then(res => {
    const lista = Array.isArray(res) ? res : [];
    if (!lista.length) {
      cont.innerHTML = '<p class="paredon-vacio">Todavía no hay huellas. Sé el primero.</p>';
      return;
    }
    cont.innerHTML = '<div class="paredon">' + lista.map(h =>
      '<div class="placa">' +
        '<div class="momento">Momento Nº ' + escapeHtml(h.Momento) + '</div>' +
        '<div class="nombre-lugar">' + escapeHtml(h.NombreApodo || 'Anónimo') + (h.Lugar ? ' · ' + escapeHtml(h.Lugar) : '') + '</div>' +
        '<div class="fecha">' + escapeHtml(h.Fecha || '') + '</div>' +
        (h.Frase ? '<div class="frase">“' + escapeHtml(h.Frase) + '”</div>' : '') +
      '</div>'
    ).join('') + '</div>';
  });
}

if (!SCRIPT_URL) {
  document.getElementById('paredon-contenido').innerHTML = '<p class="paredon-vacio">Esta página todavía no está conectada a la base de datos.</p>';
} else {
  cargarParedon();
}
</script>
</body>
</html>
